# Optional overrides. The app ships with the Chessmate Supabase project's
# public (publishable) URL and key, so you don't need a .env to run it.
VITE_SUPABASE_URL=https://dmynmniiapfrpzfxgqwn.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
# Set to "/" when serving from a custom domain instead of /chessmate/
VITE_BASE=/chessmate/
