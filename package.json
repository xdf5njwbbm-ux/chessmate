{
  "name": "russian-chess-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "test:chess": "node --experimental-strip-types --no-warnings supabase/functions/game/logic.test.ts",
    "test:phrases": "node --experimental-strip-types --no-warnings src/lib/movePhrases.test.ts",
    "test": "npm run content:check && npm run test:chess && npm run test:phrases && npm run test:blindfold && npm run test:questions && npm run test:talk && npm run test:kakdela && npm run test:roleplay && npm run test:voice",
    "test:blindfold": "node --experimental-strip-types --no-warnings src/lib/blindfold.test.ts",
    "test:questions": "node --experimental-strip-types --no-warnings src/lib/moveQuestions.test.ts",
    "test:talk": "node --experimental-strip-types --no-warnings src/lib/talk.test.ts",
    "test:kakdela": "node --experimental-strip-types --no-warnings src/lib/kakDela.test.ts",
    "test:roleplay": "node --experimental-strip-types --no-warnings src/lib/roleplay/roleplay.test.ts",
    "test:voice": "node --experimental-strip-types --no-warnings supabase/functions/_shared/voice/voice.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.119.2",
    "chess.js": "^1.4.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.4",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
